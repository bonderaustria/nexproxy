#!/bin/bash -e

# Note: This script is designed to be run inside a Docker Build for a container

CYAN='\E[1;36m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
GREEN='\E[1;32m'
RESET='\E[0m'

S6_OVERLAY_VERSION=3.2.1.0
TARGETPLATFORM=${1:-linux/amd64}

# Determine the correct binary file for the architecture given
case $TARGETPLATFORM in
	linux/arm64)
		S6_ARCH=aarch64
		;;

	*)
		S6_ARCH=x86_64
		;;
esac

echo -e "${BLUE}❯ ${CYAN}Installing S6-overlay v${S6_OVERLAY_VERSION} for ${YELLOW}${TARGETPLATFORM} (${S6_ARCH})${RESET}"

# Prefer tarballs bundled into the build context (docker/s6-cache) so the build
# does not depend on GitHub being reachable; fall back to downloading.
if [ -f "/tmp/s6-cache/s6-overlay-noarch.tar.xz" ]; then
	cp "/tmp/s6-cache/s6-overlay-noarch.tar.xz" '/tmp/s6-overlay-noarch.tar.xz'
else
	curl -fL --retry 5 --retry-delay 3 --retry-all-errors -o '/tmp/s6-overlay-noarch.tar.xz' "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz"
fi
if [ -f "/tmp/s6-cache/s6-overlay-${S6_ARCH}.tar.xz" ]; then
	cp "/tmp/s6-cache/s6-overlay-${S6_ARCH}.tar.xz" "/tmp/s6-overlay-${S6_ARCH}.tar.xz"
else
	curl -fL --retry 5 --retry-delay 3 --retry-all-errors -o "/tmp/s6-overlay-${S6_ARCH}.tar.xz" "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${S6_ARCH}.tar.xz"
fi
tar -C / -Jxpf '/tmp/s6-overlay-noarch.tar.xz'
tar -C / -Jxpf "/tmp/s6-overlay-${S6_ARCH}.tar.xz"

rm -rf "/tmp/s6-overlay-${S6_ARCH}.tar.xz"

echo -e "${BLUE}❯ ${GREEN}S6-overlay install Complete${RESET}"
